    private void unlockWithPassword() {

        String password =
                passwordInput.getText().toString();

        if (password.length() == 0) {
            message.setText(
                    "Enter your vault password."
            );
            return;
        }

        try {

            String savedSalt =
                    prefs.getString(KEY_SALT, "");

            String savedHash =
                    prefs.getString(KEY_HASH, "");

            byte[] salt =
                    hexToBytes(savedSalt);

            String enteredHash =
                    hashPassword(password, salt);

            if (constantTimeEquals(
                    savedHash,
                    enteredHash
            )) {

                currentUnlockPassword = password;

                openVault();

            } else {

                message.setText(
                        "Incorrect password."
                );
            }

        } catch (Exception e) {

            message.setText(
                    "Unable to verify password."
            );
        }
    }

