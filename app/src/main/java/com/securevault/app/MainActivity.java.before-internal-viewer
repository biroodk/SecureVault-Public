                }

                if (sortMode[0] == 0) {

                    Collections.sort(
                            filtered,
                            new Comparator<VaultItem>() {
                                @Override
                                public int compare(
                                        VaultItem a,
                                        VaultItem b
                                ) {
                                    return Long.compare(
                                            b.dateAdded,
                                            a.dateAdded
                                    );
                                }
                            }
                    );

                } else if (sortMode[0] == 1) {

                    Collections.sort(
                            filtered,
                            new Comparator<VaultItem>() {
                                @Override
                                public int compare(
                                        VaultItem a,
                                        VaultItem b
                                ) {
                                    return safeName(a).compareToIgnoreCase(
                                            safeName(b)
                                    );
                                }
                            }
                    );

                } else {

                    Collections.sort(
                            filtered,
                            new Comparator<VaultItem>() {
                                @Override
                                public int compare(
                                        VaultItem a,
                                        VaultItem b
                                ) {
                                    return Long.compare(
                                            b.dateAdded,
                                            a.dateAdded
                                    );
                                }
                            }
                    );
                }

                if (filtered.isEmpty()) {

                    LinearLayout empty =
                            new LinearLayout(MainActivity.this);

                    empty.setOrientation(
