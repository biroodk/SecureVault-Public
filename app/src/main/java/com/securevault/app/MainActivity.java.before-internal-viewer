    private void openVaultFile(VaultItem item) {

        if (item == null) {
            return;
        }

        try {

            String password = currentUnlockPassword;

            if (password == null || password.isEmpty()) {
                Toast.makeText(
                        this,
                        "Vault session expired. Unlock the vault again.",
                        Toast.LENGTH_LONG
                ).show();
                return;
            }

            File encryptedFile =
                    new File(
                            getFilesDir(),
                            "vault/" + item.encryptedName
                    );

            if (!encryptedFile.exists()) {
                Toast.makeText(
                        this,
                        "Encrypted file not found.",
                        Toast.LENGTH_LONG
                ).show();
                return;
            }

            byte[] key = deriveVaultKey(password);

            File openDirectory =
                    new File(
                            getCacheDir(),
                            "vault_open"
                    );

            if (!openDirectory.exists() &&
                    !openDirectory.mkdirs()) {

                Toast.makeText(
                        this,
                        "Unable to prepare temporary file.",
                        Toast.LENGTH_LONG
                ).show();
                return;
            }

            File[] oldFiles =
                    openDirectory.listFiles();

            if (oldFiles != null) {
                for (File oldFile : oldFiles) {
                    if (oldFile != null) {
                        oldFile.delete();
                    }
                }
            }

            String safeName =
                    item.originalName == null ||
                            item.originalName.trim().isEmpty()
                            ? "vault_file"
                            : item.originalName;

            File decryptedFile =
                    new File(
                            openDirectory,
                            System.currentTimeMillis() + "_" + safeName
                    );

            VaultCrypto.decryptFile(
                    encryptedFile,
                    decryptedFile,
                    key
            );

            if (!decryptedFile.exists() ||
                    decryptedFile.length() == 0) {

                if (decryptedFile.exists()) {
                    decryptedFile.delete();
                }

                Toast.makeText(
                        this,
                        "Unable to decrypt this file.",
                        Toast.LENGTH_LONG
                ).show();
                return;
            }

            android.net.Uri fileUri =
                    androidx.core.content.FileProvider.getUriForFile(
                            this,
                            getPackageName() + ".fileprovider",
                            decryptedFile
                    );

            String mimeType =
                    item.mimeType == null ||
                            item.mimeType.trim().isEmpty()
                            ? "*/*"
                            : item.mimeType;

            android.content.Intent intent =
                    new android.content.Intent(
                            android.content.Intent.ACTION_VIEW
                    );

            intent.setDataAndType(
                    fileUri,
                    mimeType
            );

            intent.addFlags(
                    android.content.Intent.FLAG_GRANT_READ_URI_PERMISSION
            );

            try {

                startActivity(intent);

            } catch (android.content.ActivityNotFoundException e) {

                Toast.makeText(
                        this,
                        "No app is installed to open this file type.",
                        Toast.LENGTH_LONG
                ).show();
            }

        } catch (Exception e) {

            Toast.makeText(
                    this,
                    "Unable to open file: " +
                            (e.getMessage() == null
                                    ? "Unknown error"
                                    : e.getMessage()),
                    Toast.LENGTH_LONG
            ).show();
        }
    }

    private void showVaultFileMenu(VaultItem item) {

        if (item == null) {
            return;
        }

        final String[] options = {
                "📂 Open",
                "✏️ Rename",
                "📋 Copy",
                "📁 Move",
                "📤 Share",
                "🗑 Delete",
                "📤 Remove from Vault",
                "📋 File information"
        };

        new android.app.AlertDialog.Builder(this)
                .setTitle(
                        item.originalName == null
                                ? "Vault File"
                                : item.originalName
                )
                .setItems(
                        options,
                        (dialog, which) -> {

                            if (which == 0) {

                                openVaultFile(item);

                            } else if (which == 1) {

                                showRenameVaultFileDialog(item);

                            } else if (which == 2) {

                                Toast.makeText(
                                        this,
                                        "File copying coming soon.",
                                        Toast.LENGTH_SHORT
                                ).show();

                            } else if (which == 3) {

                                Toast.makeText(
                                        this,
                                        "File moving coming soon.",
                                        Toast.LENGTH_SHORT
                                ).show();

                            } else if (which == 4) {

                                Toast.makeText(
                                        this,
                                        "File sharing coming soon.",
                                        Toast.LENGTH_SHORT
                                ).show();

                            } else if (which == 5) {

                                confirmDeleteVaultFile(item);

                            } else if (which == 6) {

                                confirmRemoveVaultFile(item);

                            } else if (which == 7) {

                                File encrypted =
                                        new File(
                                                getFilesDir(),
                                                "vault/" + item.encryptedName
                                        );

                                String sizeText =
                                        encrypted.exists()
                                                ? formatFileSize(
                                                        encrypted.length()
                                                )
                                                : "Unknown";

                                new android.app.AlertDialog.Builder(this)
                                        .setTitle("File Information")
                                        .setMessage(
                                                "Name: " +
                                                        item.originalName +
                                                        "\n\nType: " +
                                                        item.mimeType +
                                                        "\n\nEncrypted size: " +
                                                        sizeText +
                                                        "\n\nAdded: " +
                                                        android.text.format.DateFormat.format(
                                                                "dd MMM yyyy, HH:mm",
                                                                item.dateAdded
                                                        )
                                        )
                                        .setPositiveButton(
                                                "OK",
                                                null
                                        )
                                        .show();
                            }
                        }
                )
                .show();
    }

    private void showRenameVaultFileDialog(VaultItem item) {

        if (item == null) {
            return;
        }

        final android.widget.EditText input =
                new android.widget.EditText(this);

        input.setSingleLine(true);
        input.setText(
                item.originalName == null
                        ? ""
                        : item.originalName
        );
        input.setSelectAllOnFocus(true);

        int padding = dp(20);

        android.widget.FrameLayout container =
                new android.widget.FrameLayout(this);

        container.setPadding(
                padding,
                dp(10),
                padding,
                0
        );

        container.addView(
                input,
                new android.widget.FrameLayout.LayoutParams(
                        android.widget.FrameLayout.LayoutParams.MATCH_PARENT,
                        android.widget.FrameLayout.LayoutParams.WRAP_CONTENT
                )
        );

        android.app.AlertDialog renameDialog =
                new android.app.AlertDialog.Builder(this)
                        .setTitle("Rename File")
                        .setMessage("Enter a new file name")
                        .setView(container)
                        .setNegativeButton(
                                "Cancel",
                                null
                        )
                        .setPositiveButton(
                                "Rename",
                                null
                        )
                        .create();

        renameDialog.setOnShowListener(dialog -> {

            renameDialog.getButton(
                    android.app.AlertDialog.BUTTON_POSITIVE
            ).setOnClickListener(v -> {

                String newName =
                        input.getText()
                                .toString()
                                .trim();

                if (newName.isEmpty()) {

                    input.setError(
                            "File name cannot be empty"
                    );
                    return;
                }

                if (newName.length() > 120) {

                    input.setError(
                            "File name is too long"
                    );
                    return;
                }

                if (newName.equals(item.originalName)) {

                    renameDialog.dismiss();
                    return;
                }

                ArrayList<VaultItem> items =
                        VaultIndex.load(this);

                String currentFolderId =
                        item.folderId == null
                                ? ""
                                : item.folderId;

                for (VaultItem other : items) {

                    if (other == null ||
                            other.id == null ||
                            item.id == null ||
                            other.id.equals(item.id)) {
                        continue;
                    }

                    String otherFolderId =
                            other.folderId == null
                                    ? ""
                                    : other.folderId;

                    if (otherFolderId.equals(currentFolderId) &&
                            other.originalName != null &&
                            other.originalName.equalsIgnoreCase(
                                    newName
                            )) {

                        input.setError(
                                "A file with this name already exists here"
                        );
                        return;
                    }
                }

                item.originalName = newName;

                VaultIndex.save(
                        this,
                        items
                );

                renameDialog.dismiss();

                Toast.makeText(
                        this,
                        "File renamed successfully.",
                        Toast.LENGTH_SHORT
                ).show();

                showFilesScreen();
            });
        });

        renameDialog.show();
    }

    private void confirmDeleteVaultFile(VaultItem item) {

        if (item == null) {
            return;
        }

        new android.app.AlertDialog.Builder(this)
                .setTitle("Delete file permanently?")
                .setMessage(
                        "This will permanently delete the encrypted file from Folder Locker.\n\n" +
                                "This action cannot be undone."
                )
                .setNegativeButton(
                        "Cancel",
                        null
                )
                .setPositiveButton(
                        "Delete",
                        (dialog, which) -> {

                            try {

                                File encrypted =
                                        new File(
                                                getFilesDir(),
                                                "vault/" + item.encryptedName
                                        );

                                boolean deleted =
                                        !encrypted.exists() ||
                                                encrypted.delete();

                                if (deleted) {

                                    VaultIndex.remove(
                                            this,
                                            item.id
                                    );

                                    Toast.makeText(
                                            this,
                                            "File permanently deleted.",
                                            Toast.LENGTH_SHORT
                                    ).show();

                                    showFilesScreen();

                                } else {

                                    Toast.makeText(
                                            this,
                                            "Unable to delete encrypted file.",
                                            Toast.LENGTH_LONG
                                    ).show();
                                }

                            } catch (Exception e) {

                                Toast.makeText(
                                        this,
                                        "Unable to delete file.",
                                        Toast.LENGTH_LONG
                                ).show();
                            }
                        }
                )
                .show();
    }

