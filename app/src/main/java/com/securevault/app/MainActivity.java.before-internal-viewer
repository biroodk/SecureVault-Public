    private void showCreateFolderDialog() {

        final EditText input = new EditText(this);

        input.setHint("Folder name");
        input.setHintTextColor(Color.rgb(120, 145, 175));
        input.setTextColor(Color.WHITE);
        input.setTextSize(16);
        input.setSingleLine(true);
        input.setPadding(
                dp(16),
                dp(12),
                dp(16),
                dp(12)
        );
        input.setBackgroundResource(R.drawable.bg_card);

        LinearLayout container =
                new LinearLayout(this);

        container.setOrientation(
                LinearLayout.VERTICAL
        );

        container.setPadding(
                dp(22),
                dp(8),
                dp(22),
                dp(4)
        );

        TextView description = text(
                "Create a private folder inside your vault.",
                13,
                Color.rgb(154, 167, 189),
                false
        );

        description.setGravity(Gravity.START);
        description.setPadding(
                0,
                0,
                0,
                dp(12)
        );

        container.addView(description);

        container.addView(
                input,
                new LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams.MATCH_PARENT,
                        dp(54)
                )
        );

        android.app.AlertDialog dialog =
                new android.app.AlertDialog.Builder(this)
                        .setTitle("＋ New Folder")
                        .setView(container)
                        .setNegativeButton(
                                "Cancel",
                                null
                        )
                        .setPositiveButton(
                                "Create",
                                null
                        )
                        .create();

        dialog.setOnShowListener(
                d -> {

                    Button create =
                            dialog.getButton(
                                    android.app.AlertDialog.BUTTON_POSITIVE
                            );

                    create.setTextColor(
                            Color.rgb(0, 217, 255)
                    );

                    create.setOnClickListener(
                            v -> {

                                String name =
                                        input.getText()
                                                .toString()
                                                .trim();

                                if (name.length() == 0) {

                                    input.setError(
                                            "Enter a folder name"
                                    );

                                    return;
                                }

                                if (name.length() > 60) {

                                    input.setError(
                                            "Folder name is too long"
                                    );

                                    return;
                                }

                                try {

                                    ArrayList<VaultFolder> folders =
                                            FolderIndex.load(
                                                    MainActivity.this
                                            );

                                    for (
                                            VaultFolder folder :
                                            folders
                                    ) {

                                        if (
                                                folder != null &&
                                                folder.name != null &&
                                                folder.parentId != null &&
                                                folder.parentId.isEmpty() &&
                                                folder.name.equalsIgnoreCase(name)
                                        ) {

                                            input.setError(
                                                    "A folder with this name already exists"
                                            );

                                            return;
                                        }
                                    }

                                    VaultFolder folder =
                                            new VaultFolder(
                                                    java.util.UUID
                                                            .randomUUID()
                                                            .toString(),
                                                    name,
                                                    "",
                                                    System.currentTimeMillis()
                                            );

                                    FolderIndex.add(
                                            MainActivity.this,
                                            folder
                                    );

                                    dialog.dismiss();

                                    Toast.makeText(
                                            MainActivity.this,
                                            "Folder created: " + name,
                                            Toast.LENGTH_SHORT
                                    ).show();

                                    showFilesScreen();

                                } catch (Exception e) {

                                    Toast.makeText(
                                            MainActivity.this,
                                            "Could not create folder.",
                                            Toast.LENGTH_SHORT
                                    ).show();
                                }
                            }
                    );
                }
        );

        dialog.show();
    }

    private void openVaultFolder(String folderId) {

        if (folderId == null || folderId.trim().isEmpty()) {
            return;
        }

        Toast.makeText(
                MainActivity.this,
                "Opening folder...",
                Toast.LENGTH_SHORT
        ).show();

        // Folder navigation UI will be expanded next.
        // For now, remember the selected folder.
        getSharedPreferences(
                "folder_locker_security",
                MODE_PRIVATE
        )
                .edit()
                .putString("current_folder_id", folderId)
                .apply();

        showFilesScreen();
    }

    private void showFolderMenu(VaultFolder folder) {

        if (folder == null) {
            return;
        }

        final String[] options = {
                "✏️  Rename",
                "📂  Move",
                "📋  Copy",
                "🗑️  Delete"
        };

        new android.app.AlertDialog.Builder(
                MainActivity.this
        )
                .setTitle(
                        folder.name == null
                                ? "Folder"
                                : folder.name
                )
                .setItems(
                        options,
                        (dialog, which) -> {

                            if (which == 0) {

                                final EditText input =
                                        new EditText(MainActivity.this);

                                input.setSingleLine(true);
                                input.setHint("Folder name");
                                input.setText(
                                        folder.name == null
                                                ? ""
                                                : folder.name
                                );
                                input.setSelectAllOnFocus(true);

                                int padding =
                                        (int) (20 * getResources()
                                                .getDisplayMetrics()
                                                .density);

                                input.setPadding(
                                        padding,
                                        padding / 2,
                                        padding,
                                        padding / 2
                                );

                                android.app.AlertDialog renameDialog =
                                        new android.app.AlertDialog.Builder(
                                                MainActivity.this
                                        )
                                                .setTitle("Rename Folder")
                                                .setView(input)
                                                .setNegativeButton(
                                                        "Cancel",
                                                        null
                                                )
                                                .setPositiveButton(
                                                        "Rename",
                                                        null
                                                )
                                                .create();

                                renameDialog.setOnShowListener(
                                        d -> {

                                            android.widget.Button renameButton =
                                                    renameDialog.getButton(
                                                            android.app.AlertDialog
                                                                    .BUTTON_POSITIVE
                                                    );

                                            renameButton.setOnClickListener(
                                                    v -> {

                                                        String newName =
                                                                input.getText()
                                                                        .toString()
                                                                        .trim();

                                                        if (newName.isEmpty()) {

                                                            input.setError(
                                                                    "Enter a folder name"
                                                            );
                                                            return;
                                                        }

                                                        if (newName.length() > 60) {

                                                            input.setError(
                                                                    "Maximum 60 characters"
                                                            );
                                                            return;
                                                        }

                                                        ArrayList<VaultFolder> folders =
                                                                FolderIndex.load(
                                                                        MainActivity.this
                                                                );

                                                        for (VaultFolder other :
                                                                folders) {

                                                            if (other == null ||
                                                                    other.id == null ||
                                                                    folder.id == null) {
                                                                continue;
                                                            }

                                                            if (!other.id.equals(folder.id) &&
                                                                    other.parentId != null &&
                                                                    other.parentId.equals(
                                                                            folder.parentId == null
                                                                                    ? ""
                                                                                    : folder.parentId
                                                                    ) &&
                                                                    other.name != null &&
                                                                    other.name.equalsIgnoreCase(
                                                                            newName
                                                                    )) {

                                                                input.setError(
                                                                        "A folder with this name already exists here"
                                                                );
                                                                return;
                                                            }
                                                        }

                                                        folder.name = newName;

                                                        FolderIndex.save(
                                                                MainActivity.this,
                                                                folders
                                                        );

                                                        renameDialog.dismiss();

                                                        Toast.makeText(
                                                                MainActivity.this,
                                                                "Folder renamed successfully.",
                                                                Toast.LENGTH_SHORT
                                                        ).show();

                                                        showFilesScreen();
                                                    }
                                            );
                                        }
                                );

                                renameDialog.show();

                            } else if (which == 1) {

                                ArrayList<VaultFolder> folders =
                                        FolderIndex.load(MainActivity.this);

                                final ArrayList<VaultFolder> destinations =
                                        new ArrayList<>();

                                // Root is always a valid destination.
                                destinations.add(
                                        new VaultFolder(
                                                "",
                                                "🏠  My Vault",
                                                "",
                                                0
                                        )
                                );

                                // Add every folder except this folder
                                // and all of its descendants.
                                for (VaultFolder candidate : folders) {

                                    if (candidate == null ||
                                            candidate.id == null ||
                                            candidate.id.equals(folder.id)) {
                                        continue;
                                    }

                                    boolean descendant = false;
                                    String checkId = candidate.parentId;

                                    while (checkId != null &&
                                            !checkId.isEmpty()) {

                                        if (checkId.equals(folder.id)) {
                                            descendant = true;
                                            break;
                                        }

                                        String nextParent = null;

                                        for (VaultFolder parent :
                                                folders) {

                                            if (parent != null &&
                                                    parent.id != null &&
                                                    parent.id.equals(checkId)) {

                                                nextParent =
                                                        parent.parentId;
                                                break;
                                            }
                                        }

                                        if (nextParent == null ||
                                                nextParent.equals(checkId)) {
                                            break;
                                        }

                                        checkId = nextParent;
                                    }

                                    if (!descendant) {
                                        destinations.add(candidate);
                                    }
                                }

                                final String[] destinationNames =
                                        new String[destinations.size()];

                                for (int i = 0;
                                        i < destinations.size();
                                        i++) {

                                    destinationNames[i] =
                                            destinations.get(i).name == null
                                                    ? "Folder"
                                                    : destinations.get(i).name;
                                }

                                android.app.AlertDialog moveDialog =
                                        new android.app.AlertDialog.Builder(
                                                MainActivity.this
                                        )
                                                .setTitle("Move Folder To")
                                                .setSingleChoiceItems(
                                                        destinationNames,
                                                        -1,
                                                        null
                                                )
                                                .setNegativeButton(
                                                        "Cancel",
                                                        null
                                                )
                                                .setPositiveButton(
                                                        "Move",
                                                        null
                                                )
                                                .create();

                                moveDialog.setOnShowListener(
                                        d -> {

                                            android.widget.ListView list =
                                                    moveDialog.getListView();

                                            android.widget.Button moveButton =
                                                    moveDialog.getButton(
                                                            android.app.AlertDialog
                                                                    .BUTTON_POSITIVE
                                                    );

                                            moveButton.setOnClickListener(
                                                    v -> {

                                                        int selected =
                                                                list.getCheckedItemPosition();

                                                        if (selected < 0) {

                                                            Toast.makeText(
                                                                    MainActivity.this,
                                                                    "Select a destination folder.",
                                                                    Toast.LENGTH_SHORT
                                                            ).show();

                                                            return;
                                                        }

                                                        String newParentId =
                                                                destinations
                                                                        .get(selected)
                                                                        .id == null
                                                                        ? ""
                                                                        : destinations
                                                                                .get(selected)
                                                                                .id;

                                                        String oldParentId =
                                                                folder.parentId == null
                                                                        ? ""
                                                                        : folder.parentId;

                                                        // Moving to the current
                                                        // parent changes nothing.
                                                        if (newParentId.equals(
                                                                oldParentId)) {

                                                            moveDialog.dismiss();

                                                            Toast.makeText(
                                                                    MainActivity.this,
                                                                    "Folder is already there.",
                                                                    Toast.LENGTH_SHORT
                                                            ).show();

                                                            return;
                                                        }

                                                        // Prevent duplicate
                                                        // folder names at destination.
                                                        for (VaultFolder other :
                                                                folders) {

                                                            if (other == null ||
                                                                    other.id == null ||
                                                                    other.id.equals(
                                                                            folder.id)) {
                                                                continue;
                                                            }

                                                            String otherParent =
                                                                    other.parentId == null
                                                                            ? ""
                                                                            : other.parentId;

                                                            if (otherParent.equals(
                                                                    newParentId
                                                            ) &&
                                                                    other.name != null &&
                                                                    folder.name != null &&
                                                                    other.name.equalsIgnoreCase(
                                                                            folder.name
                                                                    )) {

                                                                Toast.makeText(
                                                                        MainActivity.this,
                                                                        "A folder with this name already exists there.",
                                                                        Toast.LENGTH_LONG
                                                                ).show();

                                                                return;
                                                            }
                                                        }

                                                        folder.parentId =
                                                                newParentId;

                                                        FolderIndex.save(
                                                                MainActivity.this,
                                                                folders
                                                        );

                                                        moveDialog.dismiss();

                                                        // Return to root/current
                                                        // vault view after moving.
                                                        getSharedPreferences(
                                                                PREFS,
                                                                MODE_PRIVATE
                                                        )
                                                                .edit()
                                                                .putString(
                                                                        "current_folder_id",
                                                                        ""
                                                                )
                                                                .apply();

                                                        Toast.makeText(
                                                                MainActivity.this,
                                                                "Folder moved successfully.",
                                                                Toast.LENGTH_SHORT
                                                        ).show();

                                                        showFilesScreen();
                                                    }
                                            );
                                        }
                                );

                                moveDialog.show();

                            } else if (which == 2) {

                                Toast.makeText(
                                        MainActivity.this,
                                        "Copy folder coming next.",
                                        Toast.LENGTH_SHORT
                                ).show();

                            } else if (which == 3) {

                                Toast.makeText(
                                        MainActivity.this,
                                        "Delete confirmation coming next.",
                                        Toast.LENGTH_SHORT
                                ).show();
                            }
                        }
                )
                .setNegativeButton(
                        "Cancel",
                        null
                )
                .show();
    }

