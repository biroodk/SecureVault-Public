    private void createPassword() {

        String password =
                passwordInput.getText().toString();

        String confirm =
                confirmInput.getText().toString();

        if (password.length() < 6) {
            message.setText(
                    "Password must contain at least 6 characters."
            );
            return;
        }

        if (!password.equals(confirm)) {
            message.setText(
                    "Passwords do not match."
            );
            return;
        }

        try {

            byte[] salt = new byte[16];

            new SecureRandom().nextBytes(salt);

            String hash =
                    hashPassword(password, salt);

            prefs.edit()
                    .putString(
                            KEY_SALT,
                            bytesToHex(salt)
                    )
                    .putString(
                            KEY_HASH,
                            hash
                    )
                    .putBoolean(
                            KEY_FINGERPRINT,
                            false
                    )
                    .apply();

            Toast.makeText(
                    this,
                    "Vault password created.",
                    Toast.LENGTH_SHORT
            ).show();

            showUnlockScreen();

        } catch (Exception e) {

            message.setText(
                    "Unable to create the vault password."
            );
        }
    }

