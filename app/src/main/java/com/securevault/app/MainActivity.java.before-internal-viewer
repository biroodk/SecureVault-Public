                    empty.addView(emptyTitle);
                    empty.addView(emptyText);

                    fileList.addView(empty);

                } else {

                    /*
                     * FOLDERS
                     * Show root folders before encrypted files.
                     */
                    for (VaultFolder folder : vaultFolders) {

                        if (folder == null) {
                            continue;
                        }

                        String folderParentId =
                                folder.parentId == null
                                        ? ""
                                        : folder.parentId;

                        if (!folderParentId.equals(currentFolderId)) {
                            continue;
                        }

                        String folderName =
                                folder.name == null ||
                                        folder.name.trim().isEmpty()
                                        ? "Unnamed Folder"
                                        : folder.name;

                        LinearLayout folderCard =
                                new LinearLayout(MainActivity.this);

                        folderCard.setOrientation(
                                LinearLayout.HORIZONTAL
                        );

                        folderCard.setGravity(
                                Gravity.CENTER_VERTICAL
                        );

                        folderCard.setPadding(
                                dp(16),
                                dp(12),
                                dp(12),
                                dp(12)
                        );

                        folderCard.setBackgroundResource(
                                R.drawable.bg_card
                        );

                        TextView folderIcon = text(
                                "📁",
                                30,
                                Color.WHITE,
                                false
                        );

                        folderIcon.setGravity(
                                Gravity.CENTER
                        );

                        folderCard.addView(
                                folderIcon,
                                new LinearLayout.LayoutParams(
                                        dp(48),
                                        dp(52)
                                )
                        );

                        LinearLayout folderInfo =
                                new LinearLayout(
                                        MainActivity.this
                                );

                        folderInfo.setOrientation(
                                LinearLayout.VERTICAL
                        );

                        TextView folderTitle = text(
                                folderName,
                                16,
                                Color.WHITE,
                                true
                        );

                        TextView folderSubtitle = text(
                                "Private folder",
                                12,
                                Color.rgb(120, 210, 255),
                                false
                        );

                        folderInfo.addView(folderTitle);
                        folderInfo.addView(
                                folderSubtitle,
                                new LinearLayout.LayoutParams(
                                        LinearLayout.LayoutParams.WRAP_CONTENT,
                                        LinearLayout.LayoutParams.WRAP_CONTENT
                                )
                        );

                        LinearLayout.LayoutParams infoParams =
                                new LinearLayout.LayoutParams(
                                        0,
                                        LinearLayout.LayoutParams.WRAP_CONTENT,
                                        1
                                );

                        infoParams.setMargins(
                                dp(10),
                                0,
                                dp(8),
                                0
                        );

                        folderCard.addView(
                                folderInfo,
                                infoParams
                        );

                        TextView menu = text(
                                "⋮",
                                28,
                                Color.WHITE,
                                true
                        );

                        menu.setGravity(
                                Gravity.CENTER
                        );

                        menu.setPadding(
                                dp(8),
                               0,
                                dp(4),
                                0
                        );

                        menu.setOnClickListener(
                                v -> showFolderMenu(folder)
                        );

                        folderCard.addView(
                                menu,
                                new LinearLayout.LayoutParams(
                                        dp(44),
                                        dp(52)
                                )
                        );

                        folderCard.setOnClickListener(
                                v -> openVaultFolder(folder.id)
                        );

                        LinearLayout.LayoutParams cardParams =
                                new LinearLayout.LayoutParams(
                                        LinearLayout.LayoutParams.MATCH_PARENT,
                                        LinearLayout.LayoutParams.WRAP_CONTENT
                                );

                        cardParams.setMargins(
                                0,
                                0,
                                0,
                                dp(10)
                        );

                        fileList.addView(
                                folderCard,
                                cardParams
                        );
                    }

                    /*
                     * ENCRYPTED FILES
                     */
                    for (VaultItem item : filtered) {

                        if (item == null) {
                            continue;
                        }

                        if (item.folderId != null &&
                                !item.folderId.isEmpty()) {
                            continue;
                        }

                        fileList.addView(
                                createVaultFileCard(
                                        item,
                                        MainActivity.this
                                )
                        );
                    }
                }
            }
        };

        search.addTextChangedListener(
                new android.text.TextWatcher() {

                    @Override
                    public void beforeTextChanged(
                            CharSequence s,
                            int start,
                            int count,
                            int after
                    ) {}

                    @Override
                    public void onTextChanged(
                            CharSequence s,
                            int start,
                            int before,
                            int count
                    ) {
                        refresh.run();
                    }

                    @Override
                    public void afterTextChanged(
                            android.text.Editable s
                    ) {}
                }
        );

        sortButton.setOnClickListener(v -> {

            sortMode[0]++;

            if (sortMode[0] > 1) {
                sortMode[0] = 0;
            }

            if (sortMode[0] == 0) {
                sortButton.setText("↕ Recent");
            } else {
                sortButton.setText("A–Z");
            }

            refresh.run();
        });
setContentView(root);

        root.addView(
                page,
                new LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams.MATCH_PARENT,
                        0,
                        1
                )
        );

        refresh.run();

        fadeIn(root, 500, 0);
    }

