                    .setTitle("＋ Add to Vault")
                    .setItems(options, (dialog, which) -> {

                        if (which == 0) {
                            showCreateFolderDialog();
                        } else if (which == 1) {
                            openFilePicker();
                        }

                    })
                    .setNegativeButton("Cancel", null)
                    .show();
        });

        page.addView(addButton, addParams);

        final int[] sortMode = {0};

        Runnable refresh = new Runnable() {
            @Override
            public void run() {

                fileList.removeAllViews();

                ArrayList<VaultFolder> vaultFolders =
                        FolderIndex.load(MainActivity.this);

                ArrayList<VaultItem> items =
                        VaultIndex.load(MainActivity.this);

                countText.setText(
                        items.size() + (items.size() == 1 ? " file" : " files")
                );

                String query =
                        search.getText().toString().trim().toLowerCase(Locale.US);

                ArrayList<VaultItem> filtered =
                        new ArrayList<>();

                for (VaultItem item : items) {

                    if (item == null) {
                        continue;
                    }

                    String itemFolderId =
                            item.folderId == null
                                    ? ""
                                    : item.folderId;

                    if (!itemFolderId.equals(currentFolderId)) {
