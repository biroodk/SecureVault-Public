    private String formatFileSize(long bytes) {

        if (bytes < 1024) {
            return bytes + " B";
        }

        if (bytes < 1024 * 1024) {
            return String.format(
                    Locale.US,
                    "%.1f KB",
                    bytes / 1024.0
            );
        }

        return String.format(
                Locale.US,
                "%.1f MB",
                bytes / (1024.0 * 1024.0)
        );
    }

