    private boolean deleteOriginalDocument(Uri uri) {
        try {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.KITKAT) {
                return DocumentsContract.deleteDocument(
                        getContentResolver(),
                        uri
                );
            }
        } catch (Exception ignored) {
        }

        return false;
    }

    private void processSelectedFiles(
            java.util.ArrayList<Uri> uris,
            String password
    ) {

        Toast.makeText(
                this,
                "Securing selected file(s)...",
                Toast.LENGTH_SHORT
        ).show();

        final byte[] key;

        try {
            key = deriveVaultKey(password);
        } catch (Exception e) {

            Toast.makeText(
                    this,
                    "Could not create vault encryption key.",
                    Toast.LENGTH_LONG
            ).show();

            return;
        }

        final java.util.concurrent.ExecutorService executor =
                java.util.concurrent.Executors
                        .newSingleThreadExecutor();

        executor.execute(() -> {

            int successCount = 0;
            int originalDeleteFailedCount = 0;
            int failedCount = 0;

            for (Uri uri : uris) {

                try {

                    String fileName =
                            getDisplayName(uri);

                    if (fileName == null ||
                            fileName.trim().isEmpty()) {

                        fileName =
                                "file_" +
                                System.currentTimeMillis();
                    }

                    String safeName =
                            createVaultFileName(
                                    fileName
                            );

                    VaultCrypto.encryptUri(
                            MainActivity.this,
                            uri,
                            key,
                            safeName
                    );

                    String mimeType =
                            getContentResolver()
                                    .getType(uri);

                    VaultItem item =
                            new VaultItem(
                                    java.util.UUID
                                            .randomUUID()
                                            .toString(),
                                    fileName,
                                    safeName + ".vault",
                                    mimeType != null
                                            ? mimeType
                                            : "application/octet-stream",
                                    System.currentTimeMillis()
                            );

                    VaultIndex.add(
                            MainActivity.this,
                            item
                    );

                    if (deleteOriginalDocument(uri)) {
                        successCount++;
                    } else {
                        originalDeleteFailedCount++;
                    }

                } catch (Exception e) {

                    failedCount++;
                }
            }

            int finalSuccessCount =
                    successCount;

            int finalOriginalDeleteFailedCount =
                    originalDeleteFailedCount;

            int finalFailedCount =
                    failedCount;

            runOnUiThread(() -> {

                executor.shutdown();

                String resultMessage;

                if (finalFailedCount == 0 &&
                        finalOriginalDeleteFailedCount == 0) {

                    resultMessage =
                            finalSuccessCount +
                            " file(s) encrypted, stored securely, " +
                            "and original(s) removed.";

                } else if (finalOriginalDeleteFailedCount > 0 &&
                        finalFailedCount == 0) {

                    resultMessage =
                            finalSuccessCount +
                            " secured. " +
                            finalOriginalDeleteFailedCount +
                            " encrypted, but the original file(s) " +
                            "could not be removed.";

                } else {

                    resultMessage =
                            finalSuccessCount +
                            " secured, " +
                            finalOriginalDeleteFailedCount +
                            " original(s) could not be removed, " +
                            finalFailedCount +
                            " failed.";
                }

                Toast.makeText(
                        this,
                        resultMessage,
                        Toast.LENGTH_LONG
                ).show();
            });
        });
    }

    private String getDisplayName(Uri uri) {

        android.database.Cursor cursor = null;

        try {

            cursor =
                    getContentResolver()
                            .query(
                                    uri,
                                    new String[]{
                                            android.provider.OpenableColumns.DISPLAY_NAME
                                    },
                                    null,
                                    null,
                                    null
                            );

            if (cursor != null &&
                    cursor.moveToFirst()) {

                int index =
                        cursor.getColumnIndex(
                                android.provider.OpenableColumns
                                        .DISPLAY_NAME
                        );

                if (index >= 0) {
                    return cursor.getString(index);
                }
            }

        } finally {

            if (cursor != null) {
                cursor.close();
            }
        }

        return null;
    }

    private String createVaultFileName(
            String originalName
    ) {

        String safe =
                originalName.replaceAll(
                        "[^a-zA-Z0-9._-]",
                        "_"
                );

        return System.currentTimeMillis() +
                "_" +
                safe;
    }

